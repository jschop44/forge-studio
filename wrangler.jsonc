{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "forge-studio-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "keep_vars": true,
  "vars": {
    "ENABLE_AGENT_QUEUE": "true",
    "ENABLE_FORGE_LEARNING_MEMORY": "true",
    "ENABLE_REGISTRATION": "false",
    "ENABLE_ECOSYSTEM_INTEGRATION": "true",
    "ENABLE_BUSINESS_PUBLISHING": "true"
  }
}
