# Server-side only. Never commit a real secret.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Keep disabled until authentication and durable rate limiting are implemented.
ENABLE_AI_GENERATION=false
# Dedicated Forge Studio database and session signing secret (optional)
DATABASE_URL=
AUTH_SECRET=
# Keep publishing off until migrations and auth are deployed.
ENABLE_PUBLISHING=false

# Opt-in ecosystem integrations; disabled by default.
ENABLE_ECOSYSTEM_INTEGRATION=false
# Requires migrated database, published projects, and abuse controls.
ENABLE_LEAD_CAPTURE=false

# Owner registration and private file uploads.
ENABLE_REGISTRATION=false
ENABLE_ASSET_STORAGE=false
# Signed integration events and durable agent planning.
ENABLE_AGENT_QUEUE=false
FORGE_INTEGRATION_SECRET=
