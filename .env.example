# Server-side only. Never commit a real secret.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Keep disabled until authentication and durable rate limiting are implemented.
ENABLE_AI_GENERATION=false
# Dedicated Forge Studio database and session signing secret (optional)
DATABASE_URL=
AUTH_SECRET=
# Keep publishing off until migrations and auth are deployed.
ENABLE_PUBLISHING=false
