{
  "name": "forge-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "verify:free-ai": "node scripts/verify-free-ai.mjs",
    "smoke:ai": "node scripts/smoke-local-ai.mjs",
    "test": "tsx --test tests/*.test.ts src/lib/*.test.ts",
    "test:workers": "node --test tests/*.test.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "verify": "npm run verify:free-ai && npm test && npm run test:workers && npm run typecheck && npm run build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0",
    "three": "^0.175.0",
    "@react-three/fiber": "^9.1.0",
    "@react-three/drei": "^10.0.0",
    "zod": "^3.24.0",
    "@neondatabase/serverless": "^1.0.0",
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.175.0",
    "tsx": "^4.20.0",
    "@playwright/test": "^1.56.0"
  }
}
